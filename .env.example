# Django Core Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# AI Settings (Edara AI - Anthropic)
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MODEL=claude-haiku-5-5
AI_DEFAULT_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT=60

# Celery Settings (for async task processing)
# For development, tasks run synchronously (TASK_ALWAYS_EAGER=True)
# For production, set up Redis and change to False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
